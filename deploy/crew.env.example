# Crew settings. Copy to ~/.config/crew/crew.env (mode 600); ./master.sh setup does this for you.
# PostgreSQL for Crew's sessions, events and approvals (any PostgreSQL 14+; pgvector is optional for now).
CREW_DATABASE_URL=postgresql://crew:CHANGE_ME@127.0.0.1:5432/crew
# Optional: a throwaway database for ./master.sh test (its tables are dropped).
# CREW_TEST_DATABASE_URL=postgresql://crew_test:CHANGE_ME@127.0.0.1:5432/crew_test

# Where the agents work (their terminal's starting folder).
CREW_WORKDIR=~
# Addresses to listen on: loopback (Tailscale Serve proxies to it) and the home network ("lan" is
# this machine's main IPv4). 0.0.0.0 would clash with Tailscale Serve on the same port.
CREW_HOST=127.0.0.1,lan
CREW_PORT=8800

# The agents' own Brave: profile folder, DevTools port (loopback only), desktop display.
CREW_BROWSER_PROFILE=~/.local/share/crew/agent-brave
CREW_CDP_PORT=9222
# CREW_BROWSER=/usr/bin/brave-browser
# CREW_DISPLAY=:0
# Brave renders in software (--disable-gpu): with the GPU it stops painting once the monitor sleeps.
# CREW_BROWSER_GPU=1 keeps the GPU on a machine whose display is always on.
# CREW_BROWSER_GPU=0
# The machine's real, fixed location for pages that ask for it (no GPS or Wi-Fi on a home server):
# latitude,longitude[,accuracy in metres]. Unset: pages get no location.
# CREW_BROWSER_LOCATION=

# Where Crew keeps files (attachments go to <dir>/common/attachments) and the largest upload.
# Timezone for routine schedules (default: this machine's timezone).
# CREW_TIMEZONE=Asia/Kolkata
CREW_DATA_DIR=~/.crew
CREW_MAX_UPLOAD_MB=1024

# Folders the agents hand files back from (colon-separated). The app shows a file under one of them as a
# download when a reply names its path. Default: $CREW_WORKDIR/outputs.
# CREW_SHARE_DIRS=~/outputs
