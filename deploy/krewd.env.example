# Krewd settings. Copy to ~/.config/krewd/krewd.env (mode 600); ./master.sh setup does this for you.
# PostgreSQL for Krewd's sessions, events and approvals (any PostgreSQL 14+; pgvector is optional for now).
KREWD_DATABASE_URL=postgresql://krewd:CHANGE_ME@127.0.0.1:5432/krewd
# Optional: a throwaway database for ./master.sh test (its tables are dropped).
# KREWD_TEST_DATABASE_URL=postgresql://krewd_test:CHANGE_ME@127.0.0.1:5432/krewd_test

# Where the agents work (their terminal's starting folder).
KREWD_WORKDIR=~
# Addresses to listen on: loopback (plain HTTP, for local tools and an HTTPS proxy such as Tailscale Serve or
# Caddy) and the network ("lan" is this machine's main IPv4; HTTPS with Krewd's own certificate). 0.0.0.0 would
# clash with Tailscale Serve on the same port, and would put loopback on HTTPS too.
KREWD_HOST=127.0.0.1,lan
KREWD_PORT=8800
# HTTPS on every non-loopback address with Krewd's own certificate (auto, the default), or off (plain HTTP;
# the app refuses it). The certificate and key default to tls.crt and tls.key in this folder; point these
# at a certificate from an authority instead if you have one.
# KREWD_TLS=auto
# KREWD_TLS_CERT=~/.config/krewd/tls.crt
# KREWD_TLS_KEY=~/.config/krewd/tls.key
# Other HTTPS addresses the app should know, comma-separated (Tailscale Serve, a domain), for the connect code.
# KREWD_URLS=https://machine.tailnet.ts.net:8800
# Announce the HTTPS address on the local network (mDNS), so the app finds it after an address change. 0: off.
# KREWD_MDNS=1

# Phone passkeys as owner keys, next to the security key: a public domain serving /.well-known/assetlinks.json
# for app.krewd (copy it from https://<krewd>/.well-known/assetlinks.json), and the app's signing certificate SHA-256.
# KREWD_PASSKEY_RP_ID=owner.example.com
# KREWD_PASSKEY_CERTS=7d4f9c...

# The agents' own Brave: profile folder, DevTools port (loopback only).
KREWD_BROWSER_PROFILE=~/.local/share/krewd/agent-brave
KREWD_CDP_PORT=9222
# KREWD_BROWSER=/usr/bin/brave-browser
# Where Brave draws: "virtual" (default) gives it its own invisible screen (Xvfb, `sudo apt install xvfb`), so it
# never appears on or takes focus from the desktop of whoever uses this machine; the phone's Browser tab is its
# screen. "desktop" puts its window on the desktop display KREWD_DISPLAY instead (the old way).
# KREWD_BROWSER_DISPLAY=virtual
# KREWD_DISPLAY=:0
# Brave renders in software (--disable-gpu): with the GPU it stops painting once the monitor sleeps.
# KREWD_BROWSER_GPU=1 keeps the GPU on a machine whose display is always on.
# KREWD_BROWSER_GPU=0
# The location pages in Brave are told (no GPS or Wi-Fi on a home server), until you apply one in the app
# (Settings > Browser location, or the Browser tab's menu): latitude,longitude[,accuracy in metres].
# Unset and nothing applied: pages that ask for the location get Brave's own, which waits forever on Linux.
# KREWD_BROWSER_LOCATION=

# Where Krewd keeps files (attachments go to <dir>/common/attachments) and the largest upload.
# Timezone for routine schedules (default: this machine's timezone).
# KREWD_TIMEZONE=Asia/Kolkata
KREWD_DATA_DIR=~/.krewd
KREWD_MAX_UPLOAD_MB=1024

# Folders the agents hand files back from (colon-separated). The app shows a file under one of them as a
# download when a reply names its path. Default: $KREWD_WORKDIR/outputs.
# KREWD_SHARE_DIRS=~/outputs

# Voice input (the mic in a chat's composer; voice.py). Off until a transcription API is set: any OpenAI-compatible
# /audio/transcriptions API (here the Model Warehouse's Bark 3.0 Clean). KREWD_VOICE_STT_FIELDS adds form fields to each
# request (store=false: the Model Warehouse keeps nothing).
# KREWD_VOICE_STT_URL=http://127.0.0.1:8780/v1
# KREWD_VOICE_STT_MODEL=bark-3.0-clean
# KREWD_VOICE_STT_FIELDS=store=false
# Live mode (words while speaking, a switch in the app's voice settings): a live model on the same API, the Model
# Warehouse's nemotron-live. Unset: only pieces.
# KREWD_VOICE_LIVE_MODEL=nemotron-live
# Me / Others comes from the same API: a model that lists speaker_labels in /models (the Warehouse's Bark 3.0 Clean).
