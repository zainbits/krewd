# Krewd demo server: a second, throwaway Krewd for screenshots, videos and talks. Written by
# ./master.sh demo setup; it never shares data, keys or logins with the real Krewd on this machine.
KREWD_DATABASE_URL=@DATABASE_URL@
# The demo's own fake home: `~` for the demo server and its agents, with ~/outputs for handed-back files.
KREWD_WORKDIR=@DEMO_DIR@/home
KREWD_SHARE_DIRS=@DEMO_DIR@/home/outputs
KREWD_DATA_DIR=@DEMO_DIR@/data
KREWD_STATE_DIR=@DEMO_DIR@/state
# Its own port. Loopback is plain HTTP; add an address the phone can reach (the LAN is "lan"; a
# Tailscale address works where a firewall only opens the real Krewd's port on the LAN).
KREWD_HOST=@HOST@
KREWD_PORT=@PORT@
KREWD_MDNS=0
# Its own Brave, with its own profile and DevTools port, on the same desktop as the agents' Brave.
KREWD_BROWSER_PROFILE=@DEMO_DIR@/brave
KREWD_CDP_PORT=@CDP_PORT@
KREWD_DISPLAY=@DISPLAY@
KREWD_TIMEZONE=@TIMEZONE@
