<?xml version="1.0" encoding="utf-8"?>
<!-- No plain HTTP anywhere: the Krewd server serves HTTPS on every network address. Its own certificate is
     trusted by pin in code (data/Tls.kt); every other certificate must come from a system authority. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
